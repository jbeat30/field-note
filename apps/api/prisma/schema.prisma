// T0-4 격리 스파이크용 최소 스키마 (실제 업무 테이블은 P0·P1에서 추가)
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 회사 상태: 정지·해지 요청 중에는 로그인 차단 (해지는 P0-11)
enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSING

  @@map("company_status")
}

// 계정 상태: 운영자 초대만 된 상태와 가입 완료 상태
enum UserStatus {
  INVITED
  ACTIVE

  @@map("user_status")
}

// 동의 대상 문서 종류. 마케팅 수신은 별도 선택 동의
enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING

  @@map("legal_document_type")
}

model Company {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  status             CompanyStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  projects           Project[]
  memos              Memo[]
  users              User[]
  sessions           Session[]
  consents           Consent[]
  credentials        UserCredential[]
  invitations        Invitation[]
  operatorActions    OperatorAction[]
  emailVerifications EmailVerification[]

  @@map("companies")
}

model Project {
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id])
  memos     Memo[]

  // 복합 키: 다른 회사 행과의 연결을 외래 키 단계에서 차단
  @@id([companyId, id])
  @@map("projects")
}

model Memo {
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id])
  project   Project  @relation(fields: [companyId, projectId], references: [companyId, id])

  @@id([companyId, id])
  @@map("memos")
}

// 서버 세션 (토큰 원문은 저장하지 않고 SHA-256 해시만 저장). 로그인 전 조회가 필요해 회사 범위 밖 전용 계정만 접근
model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id])
  // 세션의 사용자는 같은 회사 소속이어야 함
  user      User     @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// 회사 관리자 계정 (회사당 하나). 직원은 계정이 없음
model User {
  id                String             @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  // 인증 전에는 비어 있고 서비스 전체에서 유일
  email             String?            @unique
  emailVerifiedAt   DateTime?          @map("email_verified_at") @db.Timestamptz(3)
  // 이름 또는 상호
  displayName       String             @map("display_name")
  phone             String?
  // 만 14세 이상 확인 시각
  ageConfirmedAt    DateTime?          @map("age_confirmed_at") @db.Timestamptz(3)
  status            UserStatus         @default(INVITED)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company           Company            @relation(fields: [companyId], references: [id])
  credential        UserCredential?
  consents          Consent[]
  sessions          Session[]
  invitations       Invitation[]
  emailVerification EmailVerification?

  @@id([companyId, id])
  // 한 회사에 계정은 하나
  @@unique([companyId])
  @@map("users")
}

// 로그인 자격 (회사 범위 밖 전용 계정만 접근). 소셜 로그인만 쓰면 행이 없거나 값이 비어 있음
model UserCredential {
  companyId        String    @map("company_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  // 서비스 전체에서 유일한 로그인 아이디 (소문자)
  loginId          String?   @unique @map("login_id")
  // 복원 불가능한 해시만 저장
  passwordHash     String?   @map("password_hash")
  // 연속 로그인 실패 횟수와 잠금 해제 시각 (성공하면 0으로 초기화)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company          Company   @relation(fields: [companyId], references: [id])
  user             User      @relation(fields: [companyId, userId], references: [companyId, id])

  @@id([companyId, userId])
  @@map("user_credentials")
}

// 약관·개인정보 처리방침 등의 버전 (회사와 무관한 공용 자료, 쓰기는 운영 경로만)
model LegalDocument {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        LegalDocumentType
  version     String
  effectiveAt DateTime          @map("effective_at") @db.Timestamptz(3)
  // 동의 시점에 어떤 내용이었는지 증명하는 본문 해시
  contentHash String            @map("content_hash")
  // 필수 동의 여부 (마케팅은 선택)
  isRequired  Boolean           @map("is_required")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  consents    Consent[]

  @@unique([type, version])
  @@map("legal_documents")
}

// 동의 이력 (추가만 가능). 철회는 is_agreed=false 행을 새로 추가하고 가장 최근 행이 현재 상태
model Consent {
  id         String        @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  documentId String        @map("document_id") @db.Uuid
  isAgreed   Boolean       @default(true) @map("is_agreed")
  decidedAt  DateTime      @default(now()) @map("decided_at") @db.Timestamptz(3)
  company    Company       @relation(fields: [companyId], references: [id])
  user       User          @relation(fields: [companyId, userId], references: [companyId, id])
  document   LegalDocument @relation(fields: [documentId], references: [id])

  @@id([companyId, id])
  @@index([companyId, userId, documentId])
  @@map("consents")
}

// 운영자가 발급하는 1회용 초대 링크 (토큰 원문은 저장하지 않고 SHA-256 해시만 저장)
// 가입 전에는 회사를 알 수 없어 회사 범위 밖 전용 계정과 운영자 계정만 접근
model Invitation {
  tokenHash String    @id @map("token_hash")
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  // 가입에 사용된 시각. 값이 있으면 폐기된 링크
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  company   Company   @relation(fields: [companyId], references: [id])
  user      User      @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([companyId, userId])
  @@index([expiresAt])
  @@map("invitations")
}

enum OperatorActionType {
  COMPANY_CREATED
  INVITATION_ISSUED

  @@map("operator_action_type")
}

// 운영자 작업 기록 (추가만 가능, §5.4). 개인정보는 담지 않고 대상 회사 식별값과 작업자만 기록
model OperatorAction {
  id        String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String             @map("company_id") @db.Uuid
  action    OperatorActionType
  // 작업을 실행한 운영자 (OS 사용자명)
  operator  String
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  company   Company            @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("operator_actions")
}

// 이메일 인증 코드 상태 (사용자당 한 행). 코드 원문은 저장하지 않고 서버 비밀 값으로 만든 HMAC 해시만 저장
// 요청 기록(횟수·간격 제한)과 코드를 한 곳에 두고, 회사 범위 밖 전용 계정만 접근
model EmailVerification {
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  // 코드를 보낸 이메일 주소 (가입 후 이메일이 바뀌어도 이전 코드는 쓰지 못하게 구분)
  email           String
  codeHash        String?   @map("code_hash")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  // 틀린 입력 횟수 (제한을 넘으면 새 코드를 받아야 함)
  attempts        Int       @default(0)
  lastRequestedAt DateTime  @map("last_requested_at") @db.Timestamptz(3)
  // 시간당 발송 횟수 제한용 구간 시작 시각과 구간 내 요청 수
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  requestCount    Int       @default(1) @map("request_count")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id])
  user            User      @relation(fields: [companyId, userId], references: [companyId, id])

  @@id([companyId, userId])
  @@map("email_verifications")
}
