// T0-4 격리 스파이크용 최소 스키마 (실제 업무 테이블은 P0·P1에서 추가)
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 회사 상태: 정지·해지 요청 중에는 로그인 차단 (해지는 P0-11)
enum CompanyStatus {
  ACTIVE
  SUSPENDED
  CLOSING
  // 해지 유예가 끝나 삭제·익명화까지 마친 회사
  CLOSED

  @@map("company_status")
}

// 계정 상태: 운영자 초대만 된 상태와 가입 완료 상태
enum UserStatus {
  INVITED
  ACTIVE

  @@map("user_status")
}

// 동의 대상 문서 종류. 마케팅 수신은 별도 선택 동의
enum LegalDocumentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING

  @@map("legal_document_type")
}

model Company {
  id                   String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                 String
  status               CompanyStatus         @default(ACTIVE)
  // 회사별 저장 용량 한도(바이트). 운영자가 서버 용량에 맞춰 조정 (서비스 기획서 §12.1)
  storageQuotaBytes    BigInt                @default(5368709120) @map("storage_quota_bytes")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  users                User[]
  sessions             Session[]
  consents             Consent[]
  credentials          UserCredential[]
  invitations          Invitation[]
  operatorActions      OperatorAction[]
  emailVerifications   EmailVerification[]
  passwordResets       PasswordReset[]
  settings             CompanySettings?
  socialAccounts       SocialAccount[]
  closure              CompanyClosure?
  optionItems          OptionItem[]
  employees            Employee[]
  partners             Partner[]
  projects             Project[]
  projectTrades        ProjectTrade[]
  projectCodeSequences ProjectCodeSequence[]
  projectStatusChanges ProjectStatusChange[]
  projectAssignments   ProjectAssignment[]
  projectPeriodChanges ProjectPeriodChange[]
  workLogs             WorkLog[]
  files                StoredFile[]
  photos               Photo[]
  memos                Memo[]
  materials            Material[]
  documents            Document[]
  documentVersions     DocumentVersion[]
  auditLogs            AuditLog[]
  materialRecords      MaterialRecord[]
  workLogEntries       WorkLogEntry[]
  workLogRevisions     WorkLogRevision[]

  @@map("companies")
}

// 프로젝트 상태 (서비스 기획서 §10.3). 전환 규칙과 이력은 P1-6에서 구현하고, P1-5에서는 등록 시 '예정'으로만 만든다
enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  SUSPENDED
  COMPLETED
  WARRANTY
  CLOSED
  CANCELLED

  @@map("project_status")
}

// 프로젝트 (서비스 기획서 §10.2). 계약 금액은 저장하지 않음
// 고객·담당자·공종은 같은 회사의 명부·직원·선택 목록만 복합 키로 가리킬 수 있음
model Project {
  companyId        String                @map("company_id") @db.Uuid
  id               String                @default(dbgenerated("uuidv7()")) @db.Uuid
  // 회사별 자동 번호 (예: 2026-012). 등록 때 정해지고 수정할 수 없음
  code             String
  name             String
  status           ProjectStatus         @default(PLANNED)
  siteName         String                @map("site_name")
  siteAddress      String?               @map("site_address")
  siteMapUrl       String?               @map("site_map_url")
  siteContactName  String?               @map("site_contact_name")
  siteContactPhone String?               @map("site_contact_phone")
  // 출입 방법, 주차, 작업 시간 제한 등
  accessMemo       String?               @map("access_memo")
  clientId         String                @map("client_id") @db.Uuid
  managerId        String                @map("manager_id") @db.Uuid
  contractDate     DateTime              @map("contract_date") @db.Date
  // 시작·종료 예정일은 작업일지를 입력할 수 있는 기간이 됨
  plannedStart     DateTime              @map("planned_start") @db.Date
  plannedEnd       DateTime              @map("planned_end") @db.Date
  // 실제 시작일·완료일은 상태를 바꿀 때 기록됨 (직접 수정하지 않음)
  actualStart      DateTime?             @map("actual_start") @db.Date
  actualEnd        DateTime?             @map("actual_end") @db.Date
  memo             String?
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company          Company               @relation(fields: [companyId], references: [id])
  client           Partner               @relation("ProjectClient", fields: [companyId, clientId], references: [companyId, id], onDelete: Restrict)
  manager          Employee              @relation("ProjectManager", fields: [companyId, managerId], references: [companyId, id], onDelete: Restrict)
  trades           ProjectTrade[]
  statusChanges    ProjectStatusChange[]
  assignments      ProjectAssignment[]
  periodChanges    ProjectPeriodChange[]
  workLogs         WorkLog[]
  files            StoredFile[]
  photos           Photo[]
  memos            Memo[]
  materialRecords  MaterialRecord[]
  documents        Document[]

  @@id([companyId, id])
  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, plannedEnd])
  @@map("projects")
}

// 프로젝트 상태 변경 이력 (변경자·시각·사유, 서비스 기획서 §10.3). 추가만 가능하고 수정·삭제할 수 없음
model ProjectStatusChange {
  companyId   String        @map("company_id") @db.Uuid
  id          String        @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  fromStatus  ProjectStatus @map("from_status")
  toStatus    ProjectStatus @map("to_status")
  // 시작일·중단일·재개일·완료일·취소일처럼 상태가 실제로 바뀐 날 (입력한 날짜)
  effectiveOn DateTime      @map("effective_on") @db.Date
  // 중단·취소는 사유가 필수
  reason      String?
  changedBy   String        @map("changed_by") @db.Uuid
  changedAt   DateTime      @default(now()) @map("changed_at") @db.Timestamptz(3)
  company     Company       @relation(fields: [companyId], references: [id])
  project     Project       @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  user        User          @relation("ProjectStatusChangedBy", fields: [companyId, changedBy], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@index([companyId, projectId, changedAt])
  @@map("project_status_changes")
}

// 투입: 직원을 프로젝트 기간 안의 일정 기간에 배정 (서비스 기획서 §9.1)
// 지우지 않고 취소 표시(cancelled_at)만 남겨, 이후 작업일지가 참조해도 기록이 보존됨
model ProjectAssignment {
  companyId      String    @map("company_id") @db.Uuid
  id             String    @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId      String    @map("project_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  // 계획 공수(분). 공수는 항상 분으로 저장하고 MD로의 환산은 보여 줄 때 회사 기준시간으로 함 (비어 있으면 계획 없음)
  plannedMinutes Int?      @map("planned_minutes")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  company        Company   @relation(fields: [companyId], references: [id])
  project        Project   @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  employee       Employee  @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@index([companyId, projectId])
  @@index([companyId, employeeId, startDate, endDate])
  @@map("project_assignments")
}

// 프로젝트 예정 기간 변경 이력 (연장·단축한 날짜와 사유, 서비스 기획서 §10.2). 추가만 가능
model ProjectPeriodChange {
  companyId String   @map("company_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  fromStart DateTime @map("from_start") @db.Date
  fromEnd   DateTime @map("from_end") @db.Date
  toStart   DateTime @map("to_start") @db.Date
  toEnd     DateTime @map("to_end") @db.Date
  reason    String?
  changedBy String   @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id])
  project   Project  @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  user      User     @relation("ProjectPeriodChangedBy", fields: [companyId, changedBy], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@index([companyId, projectId, changedAt])
  @@map("project_period_changes")
}

// 작업일지 상태: 임시 저장은 집계에서 제외, 저장됨은 집계에 반영 (서비스 기획서 §9.4)
enum WorkLogStatus {
  DRAFT
  SAVED

  @@map("work_log_status")
}

// 작업일지: 프로젝트 × 날짜마다 한 건. 공통 내용은 여기에, 직원별·작업 구분별 공수는 항목(work_log_entries)에 둠
// version은 저장(수정)할 때마다 올라가는 낙관적 잠금 값
model WorkLog {
  companyId      String            @map("company_id") @db.Uuid
  id             String            @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  workDate       DateTime          @map("work_date") @db.Date
  status         WorkLogStatus     @default(DRAFT)
  content        String            @default("")
  area           String?
  notes          String?
  isChange       Boolean           @default(false) @map("is_change")
  isAfterService Boolean           @default(false) @map("is_after_service")
  version        Int               @default(1)
  // 처음 저장(임시 저장 → 저장됨)한 시각. 지연 입력 표시의 기준
  savedAt        DateTime?         @map("saved_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company        Company           @relation(fields: [companyId], references: [id])
  project        Project           @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  entries        WorkLogEntry[]
  revisions      WorkLogRevision[]

  @@id([companyId, id])
  @@unique([companyId, projectId, workDate])
  @@index([companyId, workDate])
  @@map("work_logs")
}

// 직원별·작업 구분별 공수(분). 같은 일지에 같은 직원·작업 구분 조합은 한 번만
model WorkLogEntry {
  companyId  String     @map("company_id") @db.Uuid
  id         String     @default(dbgenerated("uuidv7()")) @db.Uuid
  workLogId  String     @map("work_log_id") @db.Uuid
  employeeId String     @map("employee_id") @db.Uuid
  categoryId String     @map("category_id") @db.Uuid
  minutes    Int
  company    Company    @relation(fields: [companyId], references: [id])
  workLog    WorkLog    @relation(fields: [companyId, workLogId], references: [companyId, id], onDelete: Restrict)
  employee   Employee   @relation(fields: [companyId, employeeId], references: [companyId, id], onDelete: Restrict)
  category   OptionItem @relation("WorkLogEntryCategory", fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@unique([companyId, workLogId, employeeId, categoryId])
  @@index([companyId, employeeId])
  @@map("work_log_entries")
}

// 수정 이력: 저장된 일지를 고칠 때마다 고치기 전 값을 JSON 스냅샷으로 남김. 추가만 가능
model WorkLogRevision {
  companyId String   @map("company_id") @db.Uuid
  id        String   @default(dbgenerated("uuidv7()")) @db.Uuid
  workLogId String   @map("work_log_id") @db.Uuid
  // 이 기록이 대체된 버전 (고치기 전 버전)
  version   Int
  snapshot  Json
  changedBy String   @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id])
  workLog   WorkLog  @relation(fields: [companyId, workLogId], references: [companyId, id], onDelete: Restrict)
  user      User     @relation("WorkLogRevisionChangedBy", fields: [companyId, changedBy], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@unique([companyId, workLogId, version])
  @@map("work_log_revisions")
}

// 프로젝트의 공종 (복수 선택)
model ProjectTrade {
  companyId String     @map("company_id") @db.Uuid
  projectId String     @map("project_id") @db.Uuid
  tradeId   String     @map("trade_id") @db.Uuid
  company   Company    @relation(fields: [companyId], references: [id])
  project   Project    @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  trade     OptionItem @relation("ProjectTradeOption", fields: [companyId, tradeId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, projectId, tradeId])
  @@map("project_trades")
}

// 프로젝트 코드 번호표: 회사·연도마다 마지막 번호 (한 문장으로 원자적으로 올려 동시 등록에도 번호가 겹치지 않음)
model ProjectCodeSequence {
  companyId  String  @map("company_id") @db.Uuid
  year       Int
  lastNumber Int     @map("last_number")
  company    Company @relation(fields: [companyId], references: [id])

  @@id([companyId, year])
  @@map("project_code_sequences")
}

// 서버 세션 (토큰 원문은 저장하지 않고 SHA-256 해시만 저장). 로그인 전 조회가 필요해 회사 범위 밖 전용 계정만 접근
model Session {
  tokenHash    String   @id @map("token_hash")
  userId       String   @map("user_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  // 기기 목록·원격 로그아웃에서 쓰는 공개용 식별자 (토큰 해시와 무관)
  publicId     String   @unique @default(dbgenerated("uuidv7()")) @map("public_id") @db.Uuid
  // 로그인 때 접속 정보에서 만든 기기 이름 (예: Chrome · macOS)
  deviceLabel  String   @default("알 수 없는 기기") @map("device_label")
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(3)
  company      Company  @relation(fields: [companyId], references: [id])
  // 세션의 사용자는 같은 회사 소속이어야 함
  user         User     @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// 회사 관리자 계정 (회사당 하나). 직원은 계정이 없음
model User {
  id                   String                @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId            String                @map("company_id") @db.Uuid
  // 인증 전에는 비어 있고 서비스 전체에서 유일
  email                String?               @unique
  emailVerifiedAt      DateTime?             @map("email_verified_at") @db.Timestamptz(3)
  // 이름 또는 상호
  displayName          String                @map("display_name")
  phone                String?
  // 만 14세 이상 확인 시각
  ageConfirmedAt       DateTime?             @map("age_confirmed_at") @db.Timestamptz(3)
  status               UserStatus            @default(INVITED)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company              Company               @relation(fields: [companyId], references: [id])
  credential           UserCredential?
  consents             Consent[]
  sessions             Session[]
  invitations          Invitation[]
  emailVerification    EmailVerification?
  passwordReset        PasswordReset?
  socialAccounts       SocialAccount[]
  projectStatusChanges ProjectStatusChange[] @relation("ProjectStatusChangedBy")
  projectPeriodChanges ProjectPeriodChange[] @relation("ProjectPeriodChangedBy")
  workLogRevisions     WorkLogRevision[]     @relation("WorkLogRevisionChangedBy")
  uploadedFiles        StoredFile[]          @relation("FileUploadedBy")
  uploadedPhotos       Photo[]               @relation("PhotoUploadedBy")
  memos                Memo[]                @relation("MemoCreatedBy")
  materialRecords      MaterialRecord[]      @relation("MaterialRecordCreatedBy")
  documents            Document[]            @relation("DocumentCreatedBy")
  documentVersions     DocumentVersion[]     @relation("DocumentVersionUploadedBy")
  auditLogs            AuditLog[]            @relation("AuditLogActor")

  @@id([companyId, id])
  // 한 회사에 계정은 하나
  @@unique([companyId])
  @@map("users")
}

// 로그인 자격 (회사 범위 밖 전용 계정만 접근). 소셜 로그인만 쓰면 행이 없거나 값이 비어 있음
model UserCredential {
  companyId        String    @map("company_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  // 서비스 전체에서 유일한 로그인 아이디 (소문자)
  loginId          String?   @unique @map("login_id")
  // 복원 불가능한 해시만 저장
  passwordHash     String?   @map("password_hash")
  // 연속 로그인 실패 횟수와 잠금 해제 시각 (성공하면 0으로 초기화)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company          Company   @relation(fields: [companyId], references: [id])
  user             User      @relation(fields: [companyId, userId], references: [companyId, id])

  @@id([companyId, userId])
  @@map("user_credentials")
}

// 약관·개인정보 처리방침 등의 버전 (회사와 무관한 공용 자료, 쓰기는 운영 경로만)
model LegalDocument {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type        LegalDocumentType
  version     String
  effectiveAt DateTime          @map("effective_at") @db.Timestamptz(3)
  // 동의 시점에 어떤 내용이었는지 증명하는 본문 해시
  contentHash String            @map("content_hash")
  // 필수 동의 여부 (마케팅은 선택)
  isRequired  Boolean           @map("is_required")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  consents    Consent[]

  @@unique([type, version])
  @@map("legal_documents")
}

// 동의 이력 (추가만 가능). 철회는 is_agreed=false 행을 새로 추가하고 가장 최근 행이 현재 상태
model Consent {
  id         String        @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  documentId String        @map("document_id") @db.Uuid
  isAgreed   Boolean       @default(true) @map("is_agreed")
  decidedAt  DateTime      @default(now()) @map("decided_at") @db.Timestamptz(3)
  company    Company       @relation(fields: [companyId], references: [id])
  user       User          @relation(fields: [companyId, userId], references: [companyId, id])
  document   LegalDocument @relation(fields: [documentId], references: [id])

  @@id([companyId, id])
  @@index([companyId, userId, documentId])
  @@map("consents")
}

// 운영자가 발급하는 1회용 초대 링크 (토큰 원문은 저장하지 않고 SHA-256 해시만 저장)
// 가입 전에는 회사를 알 수 없어 회사 범위 밖 전용 계정과 운영자 계정만 접근
model Invitation {
  tokenHash String    @id @map("token_hash")
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  // 가입에 사용된 시각. 값이 있으면 폐기된 링크
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  company   Company   @relation(fields: [companyId], references: [id])
  user      User      @relation(fields: [companyId, userId], references: [companyId, id])

  @@index([companyId, userId])
  @@index([expiresAt])
  @@map("invitations")
}

enum OperatorActionType {
  COMPANY_CREATED
  INVITATION_ISSUED

  @@map("operator_action_type")
}

// 운영자 작업 기록 (추가만 가능, §5.4). 개인정보는 담지 않고 대상 회사 식별값과 작업자만 기록
model OperatorAction {
  id        String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  companyId String             @map("company_id") @db.Uuid
  action    OperatorActionType
  // 작업을 실행한 운영자 (OS 사용자명)
  operator  String
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  company   Company            @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("operator_actions")
}

// 이메일 인증 코드 상태 (사용자당 한 행). 코드 원문은 저장하지 않고 서버 비밀 값으로 만든 HMAC 해시만 저장
// 요청 기록(횟수·간격 제한)과 코드를 한 곳에 두고, 회사 범위 밖 전용 계정만 접근
model EmailVerification {
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  // 코드를 보낸 이메일 주소 (가입 후 이메일이 바뀌어도 이전 코드는 쓰지 못하게 구분)
  email           String
  // 이메일 변경 중에는 코드를 받은 새 주소 (인증이 끝나면 계정 이메일로 반영)
  pendingEmail    String?   @map("pending_email")
  codeHash        String?   @map("code_hash")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  // 틀린 입력 횟수 (제한을 넘으면 새 코드를 받아야 함)
  attempts        Int       @default(0)
  lastRequestedAt DateTime  @map("last_requested_at") @db.Timestamptz(3)
  // 시간당 발송 횟수 제한용 구간 시작 시각과 구간 내 요청 수
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  requestCount    Int       @default(1) @map("request_count")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id])
  user            User      @relation(fields: [companyId, userId], references: [companyId, id])

  @@id([companyId, userId])
  @@map("email_verifications")
}

// 비밀번호 재설정 링크 상태 (사용자당 한 행). 토큰 원문은 저장하지 않고 SHA-256 해시만 저장하며, 사용하면 해시를 비워 폐기
model PasswordReset {
  companyId       String    @map("company_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String?   @unique @map("token_hash")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  lastRequestedAt DateTime  @map("last_requested_at") @db.Timestamptz(3)
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  requestCount    Int       @default(1) @map("request_count")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id])
  user            User      @relation(fields: [companyId, userId], references: [companyId, id])

  @@id([companyId, userId])
  @@map("password_resets")
}

// 공수 입력 방식: 비율(하루=1.0) 또는 시간 (서비스 기획서 §9.5)
enum WorkUnitMode {
  RATIO
  HOURS

  @@map("work_unit_mode")
}

// 회사 설정 (회사당 한 행, 행이 없으면 기본값으로 동작). 저장은 항상 분 단위라 기준을 바꿔도 과거 기록은 변하지 않음
model CompanySettings {
  companyId           String       @id @map("company_id") @db.Uuid
  // 하루 기준시간(분). 공수 1.0에 해당
  standardWorkMinutes Int          @default(480) @map("standard_work_minutes")
  // MM(맨먼스) 계산에 쓰는 월 기준일수
  monthlyWorkDays     Int          @default(22) @map("monthly_work_days")
  workUnitMode        WorkUnitMode @default(RATIO) @map("work_unit_mode")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company             Company      @relation(fields: [companyId], references: [id])

  @@map("company_settings")
}

// 회사가 관리하는 선택 목록 종류 (직종·작업 구분·공종·직원 구분)
enum OptionKind {
  JOB_TYPE
  WORK_CATEGORY
  TRADE
  WORKER_TYPE

  @@map("option_kind")
}

// 회사별 선택 목록 항목. 쓰지 않는 항목은 삭제하지 않고 숨김(is_active=false)으로 두어 기록에 쓰인 이름이 사라지지 않게 함
// name_key는 공백·대소문자 차이를 없앤 비교용 값으로 같은 이름의 중복을 막음
model OptionItem {
  companyId             String           @map("company_id") @db.Uuid
  id                    String           @default(dbgenerated("uuidv7()")) @db.Uuid
  kind                  OptionKind
  name                  String
  nameKey               String           @map("name_key")
  sortOrder             Int              @map("sort_order")
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company               Company          @relation(fields: [companyId], references: [id])
  employeesAsJobType    Employee[]       @relation("EmployeeJobType")
  employeesAsWorkerType Employee[]       @relation("EmployeeWorkerType")
  projectTrades         ProjectTrade[]   @relation("ProjectTradeOption")
  workLogEntries        WorkLogEntry[]   @relation("WorkLogEntryCategory")
  materialRecords       MaterialRecord[] @relation("MaterialRecordCategory")

  @@id([companyId, id])
  @@unique([companyId, kind, nameKey])
  @@index([companyId, kind, sortOrder])
  @@map("option_items")
}

// 직원 상태 (퇴사하면 신규 투입·일지 입력에서 제외되고 과거 기록은 그대로 남음)
enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT

  @@map("employee_status")
}

// 직원 카드. 직원은 서비스에 로그인하지 않으며 관리자가 기록한다 (서비스 기획서 §8)
// 주민등록번호·계좌번호·급여는 저장하지 않음. 목록 API에는 생년월일·연락처를 내보내지 않고 카드(상세)에서만 보여 줌
model Employee {
  companyId       String              @map("company_id") @db.Uuid
  id              String              @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  // 직책(표시용: 반장, 기공, 조공 등)
  title           String?
  jobTypeId       String?             @map("job_type_id") @db.Uuid
  workerTypeId    String?             @map("worker_type_id") @db.Uuid
  status          EmployeeStatus      @default(ACTIVE)
  hiredOn         DateTime?           @map("hired_on") @db.Date
  leftOn          DateTime?           @map("left_on") @db.Date
  birthDate       DateTime?           @map("birth_date") @db.Date
  phone           String?
  memo            String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company             @relation(fields: [companyId], references: [id])
  jobType         OptionItem?         @relation("EmployeeJobType", fields: [companyId, jobTypeId], references: [companyId, id], onDelete: Restrict)
  managedProjects Project[]           @relation("ProjectManager")
  workLogEntries  WorkLogEntry[]
  assignments     ProjectAssignment[]
  workerType      OptionItem?         @relation("EmployeeWorkerType", fields: [companyId, workerTypeId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@index([companyId, status])
  @@index([companyId, name])
  @@map("employees")
}

// 명부 구분: 고객(발주처·원청), 협력업체(타 공종 팀·외주), 자재 공급처 (서비스 기획서 §10.1)
enum PartnerKind {
  CLIENT
  SUBCONTRACTOR
  SUPPLIER

  @@map("partner_kind")
}

// 고객·협력업체·자재 공급처 명부. 금액·거래 내역은 다루지 않음
// 쓰지 않는 업체는 삭제하지 않고 숨김(is_active=false)으로 두어 프로젝트·자재 기록에 쓰인 상호가 사라지지 않게 함
model Partner {
  companyId       String           @map("company_id") @db.Uuid
  id              String           @default(dbgenerated("uuidv7()")) @db.Uuid
  kind            PartnerKind
  name            String
  // 같은 구분 안에서 공백·대소문자만 다른 상호를 중복으로 막기 위한 비교용 값
  nameKey         String           @map("name_key")
  contactName     String?          @map("contact_name")
  phone           String?
  memo            String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company          @relation(fields: [companyId], references: [id])
  projects        Project[]        @relation("ProjectClient")
  materialRecords MaterialRecord[] @relation("MaterialRecordPartner")

  @@id([companyId, id])
  @@unique([companyId, kind, nameKey])
  @@index([companyId, kind])
  @@map("partners")
}

// 소셜 로그인 제공자 (초기에는 카카오, 네이버·구글은 5단계)
enum SocialProvider {
  KAKAO

  @@map("social_provider")
}

// 소셜 계정 연동. 제공자가 준 사용자 번호로만 계정을 찾고 이메일이 같다는 이유로 연결하지 않음 (§6.1)
// 로그인 전에 조회해야 하므로 회사 범위 밖 전용 계정만 접근
model SocialAccount {
  provider       SocialProvider
  // 제공자가 부여한 사용자 번호 (제공자 안에서 유일)
  providerUserId String         @map("provider_user_id")
  companyId      String         @map("company_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  company        Company        @relation(fields: [companyId], references: [id])
  user           User           @relation(fields: [companyId, userId], references: [companyId, id])

  @@id([provider, providerUserId])
  // 한 계정에 같은 제공자는 하나만 연동
  @@unique([companyId, userId, provider])
  @@map("social_accounts")
}

// 계정 해지 진행 상태 (회사당 한 행). 요청하면 즉시 로그인이 막히고 14일 유예 뒤 삭제 (서비스 기획서 §6.5)
// 취소 토큰 원문은 저장하지 않고 해시만 저장. 삭제를 마치면 purged_at만 남겨 파기했다는 기록으로 보존 (개인정보 없음)
model CompanyClosure {
  companyId       String    @id @map("company_id") @db.Uuid
  requestedAt     DateTime  @map("requested_at") @db.Timestamptz(3)
  // 이 시각이 지나면 삭제 대상
  purgeAfter      DateTime  @map("purge_after") @db.Timestamptz(3)
  cancelTokenHash String?   @unique @map("cancel_token_hash")
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  purgedAt        DateTime? @map("purged_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company         Company   @relation(fields: [companyId], references: [id])

  @@map("company_closures")
}

// 업로드 파일 용도: 현장 사진, 작업자료(문서함)
enum FilePurpose {
  PHOTO
  DOCUMENT

  @@map("file_purpose")
}

// 업로드 신청(PENDING) → 올라온 뒤 내용 검사·썸네일 작업 중(PROCESSING) → 사용 가능(READY) 또는 거부(REJECTED)
enum FileStatus {
  PENDING
  PROCESSING
  READY
  REJECTED

  @@map("file_status")
}

enum FileRejectReason {
  CONTENT_MISMATCH
  SIZE_MISMATCH
  NOT_UPLOADED
  UNREADABLE_IMAGE

  @@map("file_reject_reason")
}

// 업로드 파일의 메타데이터 (실제 내용은 객체 저장소). 덮어쓰지 않고 새 파일로 추가하며, 올린 사람·시각·SHA-256을 함께 남긴다 (서비스 기획서 §12.1)
model StoredFile {
  companyId       String            @map("company_id") @db.Uuid
  id              String            @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId       String            @map("project_id") @db.Uuid
  purpose         FilePurpose
  status          FileStatus        @default(PENDING)
  originalName    String            @map("original_name")
  // 신청 때는 브라우저가 알려 준 형식, 사용 가능해진 뒤에는 내용으로 판별한 형식
  contentType     String            @map("content_type")
  // 신청한 크기. 올라온 크기와 다르면 거부
  sizeBytes       BigInt            @map("size_bytes")
  objectKey       String            @map("object_key")
  thumbnailKey    String?           @map("thumbnail_key")
  sha256          String?
  rejectReason    FileRejectReason? @map("reject_reason")
  uploadedBy      String            @map("uploaded_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  readyAt         DateTime?         @map("ready_at") @db.Timestamptz(3)
  company         Company           @relation(fields: [companyId], references: [id])
  project         Project           @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  uploader        User              @relation("FileUploadedBy", fields: [companyId, uploadedBy], references: [companyId, id], onDelete: Restrict)
  photo           Photo?
  documentVersion DocumentVersion?

  @@id([companyId, id])
  @@unique([objectKey])
  @@index([companyId, projectId, purpose])
  @@index([companyId, status])
  @@map("files")
}

// 작업 사진 구분 (서비스 기획서 §12.2)
enum PhotoCategory {
  BEFORE
  DURING
  AFTER
  DEFECT
  MATERIAL
  SAFETY
  OTHER

  @@map("photo_category")
}

// 작업 사진: 업로드 파일(files)에 구분·구역·촬영일시·설명을 붙인 기록. 파일 한 개당 사진 한 건
// workDate는 어느 날 작업의 사진인지(작업일지와 프로젝트×날짜로 연결, 일지가 아직 없어도 됨). 지우면 deleted_at만 채우는 소프트 삭제
model Photo {
  companyId   String        @map("company_id") @db.Uuid
  id          String        @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  fileId      String        @map("file_id") @db.Uuid
  category    PhotoCategory @default(OTHER)
  area        String?
  takenAt     DateTime      @map("taken_at") @db.Timestamptz(3)
  workDate    DateTime      @map("work_date") @db.Date
  description String?
  isCover     Boolean       @default(false) @map("is_cover")
  uploadedBy  String        @map("uploaded_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)
  company     Company       @relation(fields: [companyId], references: [id])
  project     Project       @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  file        StoredFile    @relation(fields: [companyId, fileId], references: [companyId, id], onDelete: Restrict)
  uploader    User          @relation("PhotoUploadedBy", fields: [companyId, uploadedBy], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@unique([companyId, fileId])
  @@index([companyId, projectId, takenAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, projectId, workDate])
  @@map("photos")
}

// 메모 태그 (서비스 기획서 §10.9)
enum MemoTag {
  NEGOTIATION
  INSTRUCTION
  ISSUE
  TODO
  OTHER

  @@map("memo_tag")
}

// 프로젝트 메모 노트 / 메모함: projectId가 없으면 메모함(아직 정리하지 않은 메모). 날짜별로 쌓이고, 지우면 deleted_at만 채우는 소프트 삭제
// 완료 표시는 "할 일" 메모에만 (done_at이 있어야 완료)
model Memo {
  companyId String    @map("company_id") @db.Uuid
  id        String    @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId String?   @map("project_id") @db.Uuid
  content   String
  tag       MemoTag   @default(OTHER)
  memoDate  DateTime  @map("memo_date") @db.Date
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  company   Company   @relation(fields: [companyId], references: [id])
  project   Project?  @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  creator   User      @relation("MemoCreatedBy", fields: [companyId, createdBy], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@index([companyId, projectId, memoDate(sort: Desc), id(sort: Desc)])
  @@index([companyId, tag, doneAt])
  @@map("memos")
}

// 자재 분류 (서비스 기획서 §11.2)
enum MaterialCategory {
  RAW
  SUB
  FINISH
  CONSUMABLE

  @@map("material_category")
}

// 자재 기록 구분: 반입 / 사용 / 반출 / 폐기 (서비스 기획서 §11.3)
enum MaterialRecordKind {
  RECEIVED
  USED
  RETURNED
  DISCARDED

  @@map("material_record_kind")
}

// 회사 자재 목록. 같은 이름도 규격이 다르면 별도 자재(예: 아연도강판 0.8T / 1.0T). 쓰지 않는 자재는 삭제하지 않고 숨김
// name_key·spec_key는 공백·대소문자 차이를 없앤 비교용 값 (규격이 없으면 빈 문자열)
model Material {
  companyId String           @map("company_id") @db.Uuid
  id        String           @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String
  nameKey   String           @map("name_key")
  spec      String?
  specKey   String           @default("") @map("spec_key")
  unit      String
  category  MaterialCategory @default(CONSUMABLE)
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  company   Company          @relation(fields: [companyId], references: [id])
  records   MaterialRecord[]

  @@id([companyId, id])
  @@unique([companyId, nameKey, specKey])
  @@map("materials")
}

// 프로젝트별 자재 기록. 잔량 = 반입 - 사용 - 반출 - 폐기. 지우면 deleted_at만 채우는 소프트 삭제
// 작업일지는 프로젝트 × record_date로 연결 (일지가 아직 없어도 기록 가능)
model MaterialRecord {
  companyId      String             @map("company_id") @db.Uuid
  id             String             @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId      String             @map("project_id") @db.Uuid
  materialId     String             @map("material_id") @db.Uuid
  recordDate     DateTime           @map("record_date") @db.Date
  kind           MaterialRecordKind
  quantity       Decimal            @db.Decimal(12, 3)
  categoryId     String?            @map("category_id") @db.Uuid
  area           String?
  partnerId      String?            @map("partner_id") @db.Uuid
  sourceText     String?            @map("source_text")
  isChange       Boolean            @default(false) @map("is_change")
  isAfterService Boolean            @default(false) @map("is_after_service")
  memo           String?
  createdBy      String             @map("created_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(3)
  company        Company            @relation(fields: [companyId], references: [id])
  project        Project            @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  material       Material           @relation(fields: [companyId, materialId], references: [companyId, id], onDelete: Restrict)
  category       OptionItem?        @relation("MaterialRecordCategory", fields: [companyId, categoryId], references: [companyId, id], onDelete: Restrict)
  partner        Partner?           @relation("MaterialRecordPartner", fields: [companyId, partnerId], references: [companyId, id], onDelete: Restrict)
  creator        User               @relation("MaterialRecordCreatedBy", fields: [companyId, createdBy], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@index([companyId, projectId, recordDate(sort: Desc), id(sort: Desc)])
  @@index([companyId, materialId])
  @@map("material_records")
}

// 작업자료 분류 (서비스 기획서 §12.3)
enum DocumentCategory {
  DRAWING
  SPEC
  WORK_ORDER
  CONTRACT
  SAFETY
  OTHER

  @@map("document_category")
}

// 감사 기록 종류 (서비스 기획서 §13.1). 지금은 민감 자료 열람·내려받기만
enum AuditAction {
  DOCUMENT_VIEWED
  DOCUMENT_DOWNLOADED

  @@map("audit_action")
}

// 작업자료 문서: 프로젝트에 붙는 개정되는 문서. 파일은 버전(document_versions)에 있고 최신 버전이 기본으로 보임
// 민감 자료(is_sensitive)는 열람·다운로드를 감사 기록으로 남김. 지우면 deleted_at만 채우는 소프트 삭제
model Document {
  companyId   String            @map("company_id") @db.Uuid
  id          String            @default(dbgenerated("uuidv7()")) @db.Uuid
  projectId   String            @map("project_id") @db.Uuid
  category    DocumentCategory  @default(OTHER)
  title       String
  isSensitive Boolean           @default(false) @map("is_sensitive")
  isPinned    Boolean           @default(false) @map("is_pinned")
  createdBy   String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(3)
  company     Company           @relation(fields: [companyId], references: [id])
  project     Project           @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  creator     User              @relation("DocumentCreatedBy", fields: [companyId, createdBy], references: [companyId, id], onDelete: Restrict)
  versions    DocumentVersion[]

  @@id([companyId, id])
  @@index([companyId, projectId, category])
  @@map("documents")
}

// 문서의 버전: 새 버전은 새 파일로 추가하고 이전 버전은 보존 (덮어쓰지 않음). 추가만 가능
model DocumentVersion {
  companyId    String     @map("company_id") @db.Uuid
  id           String     @default(dbgenerated("uuidv7()")) @db.Uuid
  documentId   String     @map("document_id") @db.Uuid
  versionNo    Int        @map("version_no")
  fileId       String     @map("file_id") @db.Uuid
  revisionDate DateTime   @map("revision_date") @db.Date
  reason       String?
  uploadedBy   String     @map("uploaded_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  company      Company    @relation(fields: [companyId], references: [id])
  document     Document   @relation(fields: [companyId, documentId], references: [companyId, id], onDelete: Restrict)
  file         StoredFile @relation(fields: [companyId, fileId], references: [companyId, id], onDelete: Restrict)
  uploader     User       @relation("DocumentVersionUploadedBy", fields: [companyId, uploadedBy], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@unique([companyId, documentId, versionNo])
  @@unique([companyId, fileId])
  @@map("document_versions")
}

// 회사 감사 기록: 수정·삭제할 수 없고 추가만 가능 (서비스 기획서 §13.1). 운영자 기록(operator_actions)과 분리
model AuditLog {
  companyId String      @map("company_id") @db.Uuid
  id        String      @default(dbgenerated("uuidv7()")) @db.Uuid
  action    AuditAction
  actorId   String      @map("actor_id") @db.Uuid
  // 대상 문서 id (문서를 지워도 기록은 남도록 외래 키 없이 값만 보관)
  targetId  String      @map("target_id") @db.Uuid
  detail    Json
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  company   Company     @relation(fields: [companyId], references: [id])
  actor     User        @relation("AuditLogActor", fields: [companyId, actorId], references: [companyId, id], onDelete: Restrict)

  @@id([companyId, id])
  @@index([companyId, action, targetId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
