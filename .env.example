# api
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# DB (docker-compose.yml의 postgres)
# DB 계정 3개: 앱(RLS 우회 불가), 마이그레이션 소유, 회사 범위 밖 전용. `pnpm db:setup`이 마이그레이션 적용과 계정 비밀번호 설정 수행
DATABASE_URL=postgresql://field_note_app:field_note_app@localhost:5432/field_note
DATABASE_MIGRATE_URL=postgresql://field_note:field_note@localhost:5432/field_note
# 회사 범위 밖 전용 계정 (로그인 전 세션 조회만 가능, 업무 테이블 권한 없음)
DATABASE_AUTH_URL=postgresql://field_note_auth:field_note_auth@localhost:5432/field_note

# 브라우저에서 접속하는 웹 주소 (CSRF Origin 검증)
APP_ORIGIN=http://localhost:5173

# 객체 저장소 (docker-compose.yml의 rustfs, S3 호환)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=field-note
S3_ACCESS_KEY=field_note
S3_SECRET_KEY=field_note_secret

# 이메일 (docker-compose.yml의 mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@field-note.local
