# 로컬 개발용 환경 변수 템플릿
# `pnpm env:init`이 이중 중괄호 토큰을 이 PC에서 새로 만든 비밀 값으로 채워 `.env`를 만든다 (직접 복사하지 않음)
# 변수를 추가·변경하면 이 파일과 apps/api/src/env.ts를 함께 고친다

# api
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# 앞단 프록시(CloudFront·로드 밸런서) 단계 수. 로컬은 프록시가 없으므로 0, 운영은 프록시 뒤에서 접속 IP(요청 횟수 제한·기기 목록)를 구분하도록 단계 수만큼 지정
TRUST_PROXY_HOPS=0

# 브라우저에서 접속하는 웹 주소 (CSRF Origin 검증, web 개발 서버 포트도 이 값을 따름)
APP_ORIGIN=http://localhost:5173

# DB 계정 6개: 마이그레이션 소유, 앱(RLS 우회 불가), 회사 범위 밖 전용(로그인 전 세션·초대 조회만), 작업 큐(큐 스키마만), 운영자(회사·초대 발급만), 삭제(해지 유예 후 삭제·익명화만)
# `pnpm db:setup`이 마이그레이션 적용과 앱·전용 계정 비밀번호 설정을 수행
DATABASE_MIGRATE_URL=postgresql://field_note:{{DB_OWNER_PASSWORD}}@localhost:5432/field_note
DATABASE_URL=postgresql://field_note_app:{{DB_APP_PASSWORD}}@localhost:5432/field_note
DATABASE_AUTH_URL=postgresql://field_note_auth:{{DB_AUTH_PASSWORD}}@localhost:5432/field_note
# 운영자 CLI(`pnpm operator`) 전용. api 서버는 이 값을 읽지 않으며, 운영에서는 운영자 PC에만 둔다
# 작업 큐(pg-boss) 전용 계정: 큐 스키마만 접근
DATABASE_QUEUE_URL=postgresql://field_note_queue:{{DB_QUEUE_PASSWORD}}@localhost:5432/field_note
# 삭제 전용 계정(`pnpm operator purge-due`): 해지 유예가 끝난 회사의 데이터 삭제·익명화만 가능. api 서버는 이 값을 읽지 않으며, 운영에서는 운영자 PC·점검 작업에만 둔다
DATABASE_PURGE_URL=postgresql://field_note_purge:{{DB_PURGE_PASSWORD}}@localhost:5432/field_note
DATABASE_OPERATOR_URL=postgresql://field_note_operator:{{DB_OPERATOR_PASSWORD}}@localhost:5432/field_note
# 조회 전용 계정: DB 도구로 직접 볼 때 사용. 회사를 지정(set_config)한 뒤 그 회사의 행만 SELECT 가능. api 서버는 이 값을 읽지 않음
DATABASE_READONLY_URL=postgresql://field_note_readonly:{{DB_READONLY_PASSWORD}}@localhost:5432/field_note

# 백업·복구 시험(`pnpm backup`) 선택 설정: BACKUP_DIR(기본 backups), BACKUP_RETENTION_DAYS(기본 30), BACKUP_PG_MODE(docker 기본, 서버에 PostgreSQL 도구가 있으면 local)

# 백업 파일 암호화 키 (32바이트 base64url, 운영 필수). 잃어버리면 백업을 풀 수 없으므로 서버 밖(비밀번호 관리자 등)에 따로 보관하고 서버와 같은 곳에만 두지 않기
BACKUP_ENCRYPTION_KEY={{BACKUP_ENCRYPTION_KEY}}

# 서버 밖 백업 저장소 (선택, 서비스 업로드 버킷과 다른 버킷·다른 접근 키를 쓰기). 다섯 값 중 일부만 넣으면 오류
# BACKUP_S3_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=

# docker-compose.yml이 읽는 값 (위 소유 계정 비밀번호와 같은 값)
POSTGRES_USER=field_note
POSTGRES_PASSWORD={{DB_OWNER_PASSWORD}}
POSTGRES_DB=field_note

# 객체 저장소 (로컬은 RustFS, S3 호환). 운영 공급자가 정해지면 값만 교체
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=field-note
S3_ACCESS_KEY={{S3_ACCESS_KEY}}
S3_SECRET_KEY={{S3_SECRET_KEY}}

# 이메일 인증 코드 해시용 서버 비밀 값 (바꾸면 발송된 미사용 코드가 모두 무효가 됨)
CODE_HASH_SECRET={{CODE_HASH_SECRET}}

# 소셜 로그인 진행 상태 쿠키 암호화용 서버 비밀 값
OAUTH_COOKIE_SECRET={{OAUTH_COOKIE_SECRET}}

# 2단계 인증(TOTP) 키를 DB에 암호화해 저장할 때 쓰는 서버 비밀 값 (32자 이상, 바꾸면 켜 둔 2단계 인증이 모두 풀림)
TOTP_ENCRYPTION_KEY={{TOTP_ENCRYPTION_KEY}}

# 소셜 로그인: 앱 등록(상용 서버 작업 때) 후 채움. 비워 두면 개발 환경은 가짜 로그인 화면, 운영은 해당 제공자 로그인 꺼짐
# 리다이렉트 주소는 앱 등록에 {APP_ORIGIN}/api/v1/auth/{kakao|naver|google}/callback 으로 등록
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 이메일 (로컬은 Mailpit, 발송 메일은 http://localhost:8025에서 확인). 운영은 SMTP 공급자 값으로 교체
SMTP_HOST=localhost
SMTP_PORT=1025
# 운영 메일 서비스의 계정 (로컬 Mailpit은 불필요하므로 주석 처리)
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=no-reply@field-note.local
