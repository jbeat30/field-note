# api
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# DB (docker-compose.yml의 postgres)
DATABASE_URL=postgresql://field_note:field_note@localhost:5432/field_note

# 객체 저장소 (docker-compose.yml의 minio, S3 호환)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=field-note
S3_ACCESS_KEY=field_note
S3_SECRET_KEY=field_note_secret

# 이메일 (docker-compose.yml의 mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@field-note.local
