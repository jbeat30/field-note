# 서버용 환경 변수 템플릿 (deploy/.env가 됨): `pnpm env:init --production`이 이중 중괄호 토큰을 새로 만든 비밀 값으로 채운다
# <꺾쇠> 값은 가입한 서비스에서 받은 값을 서버에서 직접 채운다 (이 값들은 저장소·채팅·메신저에 남기지 않음)
# 변수를 추가·변경하면 이 파일과 apps/api/src/env.ts를 함께 고친다

# 접속 주소: 서버 공인 IP의 점을 하이픈으로 바꾼 뒤 .sslip.io를 붙임 (예: 203.0.113.10 → 203-0-113-10.sslip.io)
# 이 주소로 HTTPS 인증서를 발급받고, 브라우저 접속 주소(APP_ORIGIN)도 https://이 값이 됨
SITE_ADDRESS=<서버IP-하이픈.sslip.io>

# DB (서비스 이름 db, 외부에 열지 않음). 계정 6개 중 소유 계정만 POSTGRES_*로 만들고 나머지는 마이그레이션이 만듦
POSTGRES_USER=field_note
POSTGRES_PASSWORD={{DB_OWNER_PASSWORD}}
POSTGRES_DB=field_note
DATABASE_MIGRATE_URL=postgresql://field_note:{{DB_OWNER_PASSWORD}}@db:5432/field_note
DATABASE_URL=postgresql://field_note_app:{{DB_APP_PASSWORD}}@db:5432/field_note
DATABASE_AUTH_URL=postgresql://field_note_auth:{{DB_AUTH_PASSWORD}}@db:5432/field_note
DATABASE_QUEUE_URL=postgresql://field_note_queue:{{DB_QUEUE_PASSWORD}}@db:5432/field_note

# 서버 비밀 값 (바꾸면 영향이 있으므로 정해진 뒤에는 유지, docs/10 §4.4)
CODE_HASH_SECRET={{CODE_HASH_SECRET}}
OAUTH_COOKIE_SECRET={{OAUTH_COOKIE_SECRET}}
TOTP_ENCRYPTION_KEY={{TOTP_ENCRYPTION_KEY}}

# 사진·문서 저장소 (Cloudflare R2): 이 서비스 전용 버킷과 그 버킷만 가리키는 접근 키 (백업 버킷과 다른 것)
# S3_ENDPOINT는 웹 보안 정책(CSP)의 저장소 출처로도 쓰임
S3_ENDPOINT=https://<R2 계정 ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<사진·문서 버킷 이름>
S3_ACCESS_KEY=<R2 접근 키 ID>
S3_SECRET_KEY=<R2 비밀 접근 키>

# 메일 (서비스 전용 Gmail): 보내는 주소는 로그인 계정과 같은 주소, 비밀번호는 앱 비밀번호 16자
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<서비스 Gmail 주소>
SMTP_PASSWORD=<Gmail 앱 비밀번호>
SMTP_FROM=<서비스 Gmail 주소>

# 공개 시연 환경: true면 로그인 화면에 시연 계정(Test Company)을 안내하고 새벽 초기화(operator demo-reset)가 동작함
# 시연 회사는 가상 데이터만 담으며 해지·로그인 정보 변경 등이 막혀 있음. 서비스 단계에서는 false로 두고 operator demo-remove로 정리
PUBLIC_DEMO_ENABLED=true

# 소셜 로그인: 앱 등록 뒤에 주석을 풀고 채움 (쌍이 없으면 그 제공자 로그인은 꺼짐)
# 리다이렉트 주소는 https://<SITE_ADDRESS>/api/v1/auth/{kakao|naver|google}/callback
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 자원 한도 (선택): 서버 메모리에 맞춰 조정. 기본값은 메모리 6GB 이상 기준
# DB_MEM_LIMIT=1g
# DB_SHARED_BUFFERS=256MB
# DB_CPUS=1.0
# API_MEM_LIMIT=1g
# API_HEAP_MB=640
# API_CPUS=1.0
# WEB_MEM_LIMIT=256m
# DB_POOL_MAX=5
