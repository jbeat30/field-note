# 점검 작업·운영자 전용 환경 변수 템플릿 (deploy/ops.env가 됨): api 컨테이너에는 전달하지 않음
# `pnpm env:init --production`이 deploy/env.example과 같은 비밀 값으로 채운다 (DB 계정 비밀번호가 서로 같아야 함)

# 해지 유예가 끝난 회사의 삭제·익명화(purge)와 운영자 CLI(회사·초대 발급)가 쓰는 DB 계정
DATABASE_PURGE_URL=postgresql://field_note_purge:{{DB_PURGE_PASSWORD}}@db:5432/field_note
DATABASE_OPERATOR_URL=postgresql://field_note_operator:{{DB_OPERATOR_PASSWORD}}@db:5432/field_note

# 백업 파일 암호화 키: 잃으면 백업을 풀 수 없으므로 서버 밖(비밀번호 관리자 등)에도 따로 보관
BACKUP_ENCRYPTION_KEY={{BACKUP_ENCRYPTION_KEY}}
BACKUP_RETENTION_DAYS=30

# 서버 밖 백업 저장소 (Cloudflare R2의 별도 버킷과 전용 접근 키)
BACKUP_S3_ENDPOINT=https://<R2 계정 ID>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=<백업 버킷 이름>
BACKUP_S3_ACCESS_KEY=<백업 버킷 전용 접근 키 ID>
BACKUP_S3_SECRET_KEY=<백업 버킷 전용 비밀 접근 키>
