{
  "name": "field-note",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "현장 팀 프로젝트 관리 서비스",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "dev": "pnpm infra:up && pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @field-note/api dev",
    "dev:web": "pnpm --filter @field-note/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@field-note/config": "workspace:*",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
